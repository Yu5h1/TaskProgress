  "schema_version": "1.1",
  "task_id": "report-search",
  "updated_at": "2026-10-21T00:00:00+00:00",
  "decisions": [
    {
      "id": "id-match",
      "version": 1,
      "question": "搜尋時 ID 要不要算進比對？",
      "context": "現況：狀態篩選列右側要加搜尋框，比對任務卡名稱、子項描述與卡片摘要（不分大小寫、以空白分隔的多個詞須全部命中）。卡片 ID 顯示在卡片右上角；子項 ID 畫面上不顯示，只出現在複製出來的參照「scope › 卡片 › 子項「標題前段」」裡。agent 回報時常只寫 ID（例如 ux-toggle-goal-1），你也會從 agent 的訊息或別處拿到參照。",
      "options": [
        {
          "id": "include",
          "label": "算進比對，並認得貼上的參照",
          "description": "卡片 ID、子項 ID 都參與比對；貼上整段複製參照時，直接定位到那張卡的那個子項。代價：子項 ID 看不見，偶爾會出現「畫面上看不出為何命中」的結果。"
        },
        {
          "id": "reference-only",
          "label": "只認得貼上的參照",
          "description": "一般關鍵字只比對看得到的文字；只有貼上「scope › 卡片 › 子項」格式時才用 ID 定位。不會有看不出原因的命中，但單獨輸入 ux-toggle-goal-1 找不到。"
        },
        {
          "id": "exclude",
          "label": "不算",
          "description": "只比對畫面上看得到的文字（名稱、子項描述、摘要）。最單純，但拿到 agent 回報的 ID 時無法用搜尋找到。"
        }
      ],
      "recommendation": {
        "option_id": "include",
        "reason": "和 agent 協作時 ID 是最常拿到的線索，複製參照本身也以 ID 為準；看不見的子項 ID 命中時，結果只留下那一項，原因仍然清楚。"
      },
      "allow_other": true,
      "status": "pending",
      "answer": null
    }
  ]
}
