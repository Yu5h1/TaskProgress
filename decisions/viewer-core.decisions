      "allow_other": true,
      "status": "decided",
      "answer": {
        "kind": "other",
        "text": "\u4E0D\u5C0D \u6211\u8A8D\u70BA \u4E0D\u61C9\u8A72\u6709 \u4E00\u822C \u9577\u671F \u672A\u4F86\n\n\u5C31\u662F \u7DAD\u8B77 , \u672A\u4F86\u5C31\u662F\u4E00\u500B \u4EFB\u52D9\u9700\u6C42 , \u5361\u7247 , \u7528 \u512A\u5148\u7D1A\u8868\u793A\u5C31\u597D , \u4E0D\u9700\u8981 \u5728 title \u6253 \u9577\u671F \u672A\u4F86 \u9084\u662F\u4E00\u822C",
        "confirmed_at": "2026-11-11T11:26:26.8855785\u002B00:00"
