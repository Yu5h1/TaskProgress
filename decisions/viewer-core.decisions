          "label": "\u6BCF\u500B\u5C08\u6848\u53EF\u81EA\u8A02\u5206\u5340",
          "description": "\u6BCF\u500B\u5C08\u6848\u53EF\u65B0\u589E\u3001\u547D\u540D\u53CA\u8ABF\u6574\u5206\u5340\u9806\u5E8F\uFF0C\u4E26\u5728\u9806\u6392\u6642\u986F\u793A\u5206\u5340\u3002\u9700\u8981\u7BA1\u7406\u5206\u5340\u7684\u5165\u53E3\u3002"
        }
      ],
      "recommendation": {
        "option_id": "fixed-sections",
        "reason": "\u80FD\u76F4\u63A5\u6383\u5230\u9577\u671F\u5DE5\u4F5C\u8207\u672A\u4F86\u65B9\u5411\uFF0C\u5404\u5C08\u6848\u4E5F\u7121\u9808\u5148\u8A2D\u5B9A\u5206\u985E\u3002"
