      "question": "\u4E00\u822C\u3001\u9577\u671F\u3001\u672A\u4F86\u65B9\u5411\u8981\u5982\u4F55\u5448\u73FE\u5728 Report\uFF1F",
      "context": "\u4F60\u5728 VCP \u76EE\u524D\u4EE5\u300C\u9577\u671F\uFF1A\u300D\u300C\u672A\u4F86\u65B9\u5411\uFF1A\u300D\u5BEB\u5728\u5361\u7247\u6A19\u984C\u3002Report \u4F9D\u72C0\u614B\u3001\u512A\u5148\u7D1A\u53CA\u539F\u59CB\u9806\u5E8F\u986F\u793A\u5361\u7247\u3002\u4E09\u500B\u9078\u9805\u90FD\u4FDD\u7559 Next\u3001\u91D8\u9078\u53CA\u5B8C\u6210\u5340\u3002",
      "source_ref": "../Documentation/CardDisclosurePlan.md#report-\u5361\u7247\u5206\u5340",
      "options": [
        {
          "id": "fixed-sections",
          "label": "\u56FA\u5B9A\u4E09\u500B\u5206\u5340",
          "description": "\u9806\u6392\u6642\u5728\u540C\u4E00\u72C0\u614B\u7D44\u5167\u986F\u793A\u4E00\u822C\u3001\u9577\u671F\u8207\u672A\u4F86\u65B9\u5411\u3002\u672A\u5206\u985E\u7684\u820A\u5361\u986F\u793A\u5728\u4E00\u822C\u3002"
