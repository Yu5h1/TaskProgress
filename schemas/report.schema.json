{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-progress.local/schemas/report.schema.json",
  "title": "TaskProgress Viewer Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "scope_id",
    "title",
    "updated_at",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "report_id": {
      "$ref": "#/$defs/id"
    },
    "scope_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "task": {
      "oneOf": [
        { "$ref": "#/$defs/standardTask" },
        { "$ref": "#/$defs/reportPointerTask" }
      ]
    },
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id"],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope_id"],
      "properties": {
        "kind": {
          "enum": ["checklist", "decision"]
        },
        "scope_id": {
          "$ref": "#/$defs/id"
        },
        "task": {
          "$ref": "#/$defs/id"
        },
        "stem": {
          "$ref": "#/$defs/id"
        }
      },
      "anyOf": [
        { "required": ["task"] },
        { "required": ["stem"] }
      ]
    },
    "reportPointerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "report_ref"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "const": "report_pointer"
        },
        "report_ref": {
          "$ref": "#/$defs/reportRef"
        }
      }
    },
    "standardTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "summary"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "standard"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": ["planned", "in_progress", "blocked", "done", "archive"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "completed_items": {
          "$ref": "#/$defs/itemList"
        },
        "pending_items": {
          "$ref": "#/$defs/itemList"
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "total"],
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "itemList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          {
            "$ref": "#/$defs/item"
          }
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "status": {
          "$comment": "Optional. Absent means the array the item sits in decides: completed_items reads as done, pending_items as planned. When present it is authoritative and the arrays are derived from it — done goes to completed_items, every other status to pending_items — so an item can never be in a position its own status contradicts.",
          "enum": ["planned", "in_progress", "blocked", "done", "archive"]
        },
        "document_ref": {
          "$ref": "#/$defs/documentRef"
        },
        "waits_for": {
          "$comment": "Items this item waits for, possibly in other registered scopes. While any is unfinished the item shows as waiting and run skips it. Written by the Report CLI, which rejects loops.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope_id", "task_id", "item_id"],
            "properties": {
              "scope_id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "task_id": { "$ref": "#/$defs/id" },
              "item_id": { "$ref": "#/$defs/id" }
            }
          }
        },
        "activity": {
          "$comment": "Written by the Report CLI and the Viewer, never by hand. The created entry and every started and takeover entry are kept forever, so the executors stay known; the latest released and disputed entries are kept; only the most recent 3 other entries are kept.",
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/activityEntry" }
        }
      }
    },
    "activityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "actor", "at"],
      "properties": {
        "event": { "enum": ["created", "started", "updated", "done", "takeover", "released", "disputed"] },
        "note": {
          "$comment": "Why the session disputes a condition; required for disputed.",
          "type": "string", "minLength": 1, "maxLength": 300
        },
        "actor": {
          "$comment": "The writing tool, such as claude, codex or antigravity; user for the Viewer.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "session": {
          "$comment": "The writing session's human-readable name, shown in the Viewer.",
          "type": "string", "minLength": 1, "maxLength": 100
        },
        "session_id": {
          "$comment": "The writing session's ID; claims compare this, never the name.",
          "type": "string", "minLength": 1, "maxLength": 100
        },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
