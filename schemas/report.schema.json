{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-progress.local/schemas/report.schema.json",
  "title": "TaskProgress Viewer Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "scope_id",
    "title",
    "updated_at",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "report_id": {
      "$ref": "#/$defs/id"
    },
    "scope_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "next": {
      "$ref": "#/$defs/nextMarker"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "nextMarker": {
      "$comment": "The one child item this scope should act on now. Written by the Report CLI (next.set/next.clear) or the Viewer; readers treat it as ineffective once the item is done, waiting or awaiting someone, and fall back to the derived next step. Design: Documentation/NextMarkerPlan.md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "item_id"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "item_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "task": {
      "oneOf": [
        {
          "$ref": "#/$defs/standardTask"
        },
        {
          "$ref": "#/$defs/reportPointerTask"
        }
      ]
    },
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id"
      ],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "checklist",
            "decision"
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/id"
        },
        "task": {
          "$ref": "#/$defs/id"
        },
        "stem": {
          "$ref": "#/$defs/id"
        }
      },
      "anyOf": [
        {
          "required": [
            "task"
          ]
        },
        {
          "required": [
            "stem"
          ]
        }
      ]
    },
    "cardDocumentRef": {
      "$comment": "A card binds only its own experience record, experience/<task>.md in the card's scope: one line per lesson learned while doing the card's work, read by the close-out review. Items bind checklists and decisions through documentRef instead.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope_id",
        "task"
      ],
      "properties": {
        "kind": {
          "const": "experience"
        },
        "scope_id": {
          "$ref": "#/$defs/id"
        },
        "task": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "reportPointerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "report_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "const": "report_pointer"
        },
        "report_ref": {
          "$ref": "#/$defs/reportRef"
        }
      }
    },
    "standardTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "standard"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "done",
            "archive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "completed_items": {
          "$ref": "#/$defs/itemList"
        },
        "pending_items": {
          "$ref": "#/$defs/itemList"
        },
        "document_ref": {
          "$ref": "#/$defs/cardDocumentRef"
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed",
            "total"
          ],
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "itemList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          {
            "$ref": "#/$defs/item"
          }
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "status": {
          "$comment": "Optional. Absent means the array the item sits in decides: completed_items reads as done, pending_items as planned. When present it is authoritative and the arrays are derived from it — done goes to completed_items, every other status to pending_items — so an item can never be in a position its own status contradicts. archive keeps finished work as history; obsolete (replaced by another item, retirement.replaced_by) and discontinued (dropped, retirement.reason) retire an item the user confirmed is no longer needed.",
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "done",
            "archive",
            "obsolete",
            "discontinued"
          ]
        },
        "retirement": {
          "$comment": "Only on an obsolete or discontinued item, written by the Report CLI: obsolete names the item that replaced it, discontinued names why it was dropped.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "replaced_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope_id",
                "task_id",
                "item_id"
              ],
              "properties": {
                "scope_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "task_id": {
                  "$ref": "#/$defs/id"
                },
                "item_id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "document_ref": {
          "$ref": "#/$defs/documentRef"
        },
        "waits_for": {
          "$comment": "Items or checklist work items this item waits for, possibly in other registered scopes. While any is unfinished the item shows as waiting and run skips it; a checklist work item is finished when every check in it passes. An item wait is also met when the waited item lacks only the user's [manual] acceptance, unless strict is true; if the user then fails that acceptance, a waiter that had started reads as needs_fix until it is released or done again. Written by the Report CLI, which rejects loops and targets it cannot find.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope_id",
                  "task_id",
                  "item_id"
                ],
                "properties": {
                  "scope_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "task_id": {
                    "$ref": "#/$defs/id"
                  },
                  "item_id": {
                    "$ref": "#/$defs/id"
                  },
                  "strict": {
                    "$comment": "Wait until the waited item is done, including the user's [manual] acceptance.",
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope_id",
                  "checklist",
                  "work_item"
                ],
                "properties": {
                  "scope_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "checklist": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+$",
                    "maxLength": 120
                  },
                  "work_item": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        },
        "activity": {
          "$comment": "Written by the Report CLI and the Viewer, never by hand. The created entry and every started and takeover entry are kept forever, so the executors stay known; the latest released and disputed entries are kept; only the most recent 3 other entries are kept.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/activityEntry"
          }
        }
      }
    },
    "activityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "actor",
        "at"
      ],
      "properties": {
        "event": {
          "enum": [
            "created",
            "started",
            "updated",
            "done",
            "takeover",
            "released",
            "disputed"
          ]
        },
        "note": {
          "$comment": "Why the session disputes a condition; required for disputed.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "actor": {
          "$comment": "The writing tool, such as claude, codex or antigravity; user for the Viewer.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "session": {
          "$comment": "The writing session's human-readable name, shown in the Viewer.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "session_id": {
          "$comment": "The writing session's ID; claims compare this, never the name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
