{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-progress.local/schemas/schedule.plan.schema.json",
  "title": "Schedule private input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_id",
    "scope_id",
    "timezone",
    "planning_started_at",
    "policy",
    "resources",
    "works"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "schedule_id": {
      "$ref": "#/$defs/id"
    },
    "scope_id": {
      "$ref": "#/$defs/id"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "planning_started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version"
      ],
      "properties": {
        "algorithm": {
          "const": "deterministic-forward"
        },
        "version": {
          "const": "0.1"
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "public_label",
          "capacity_source"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "person",
              "team",
              "equipment"
            ]
          },
          "public_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "capacity_source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "minutes_per_workday"
                ],
                "properties": {
                  "kind": {
                    "const": "schedule_local"
                  },
                  "minutes_per_workday": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "resource_id"
                ],
                "properties": {
                  "kind": {
                    "const": "time_projection"
                  },
                  "resource_id": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "works": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work_id",
              "kind",
              "subject",
              "dependencies",
              "constraints",
              "assignments"
            ],
            "properties": {
              "work_id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "work"
              },
              "subject": {
                "$ref": "#/$defs/subject"
              },
              "duration_source": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "likely_minutes",
                      "confidence"
                    ],
                    "properties": {
                      "kind": {
                        "const": "schedule_local"
                      },
                      "likely_minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5256000
                      },
                      "confidence": {
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "task_id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "time_projection"
                      },
                      "task_id": {
                        "$ref": "#/$defs/id"
                      },
                      "item_id": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                ]
              },
              "dependencies": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "predecessor_work_id",
                    "type",
                    "lag_minutes"
                  ],
                  "properties": {
                    "predecessor_work_id": {
                      "$ref": "#/$defs/id"
                    },
                    "type": {
                      "const": "finish_to_start"
                    },
                    "lag_minutes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5256000
                    }
                  }
                }
              },
              "constraints": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "at"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "start_no_earlier_than",
                        "start_fixed",
                        "finish_no_later_than",
                        "finish_fixed"
                      ]
                    },
                    "at": {
                      "$ref": "#/$defs/timestamp"
                    }
                  }
                }
              },
              "assignments": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "resource_id",
                    "allocation_percent",
                    "exclusive"
                  ],
                  "properties": {
                    "resource_id": {
                      "$ref": "#/$defs/id"
                    },
                    "allocation_percent": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "exclusive": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work_id",
              "kind",
              "label",
              "fixed_at",
              "movable",
              "dependencies"
            ],
            "properties": {
              "work_id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "milestone"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "fixed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "movable": {
                "const": false
              },
              "dependencies": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "predecessor_work_id",
                    "type",
                    "lag_minutes"
                  ],
                  "properties": {
                    "predecessor_work_id": {
                      "$ref": "#/$defs/id"
                    },
                    "type": {
                      "const": "finish_to_start"
                    },
                    "lag_minutes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5256000
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ],
          "properties": {
            "kind": {
              "const": "task"
            },
            "task_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "item_id"
          ],
          "properties": {
            "kind": {
              "const": "item"
            },
            "task_id": {
              "$ref": "#/$defs/id"
            },
            "item_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    }
  }
}
