{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-progress.local/schemas/module-envelope.schema.json",
  "title": "TaskProgress Module Common Envelope",
  "description": "Reusable $defs for a module sidecar's root fields. A domain schema (e.g. a future cost.analysis.schema.json) references #/$defs/envelope and narrows `data` with its own shape; it must not redefine the common fields.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "moduleType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 100
    },
    "reportRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "module_type",
        "schema_version",
        "module_id",
        "report_id",
        "scope_id",
        "generated_at",
        "generator",
        "data"
      ],
      "properties": {
        "module_type": {
          "$ref": "#/$defs/moduleType"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "module_id": {
          "$ref": "#/$defs/id"
        },
        "report_id": {
          "$ref": "#/$defs/id"
        },
        "scope_id": {
          "$ref": "#/$defs/id"
        },
        "report_revision": {
          "$ref": "#/$defs/reportRevision"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
