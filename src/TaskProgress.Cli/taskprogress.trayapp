{
  "schema": 1,
  "id": "task-progress",
  "displayName": "TaskProgress Local Server",
  "protocol": "trayhost-jsonlines-v1",
  "copy": { "URL": "http://127.0.0.1:8001/" },
  "output": { "notify": true, "clipboard": false },
  "process": {
    "executable": "task-progress.exe",
    "arguments": ["worker"],
    "workingDirectory": "."
  },
  "timeouts": {
    "startupSeconds": 60,
    "requestSeconds": 60,
    "shutdownSeconds": 15
  }
}
