{
  "schema": 2,
  "id": "task-progress",
  "displayName": "TaskProgress Local Server",
  "icon": { "text": "TP", "light": "light.ico", "dark": "dark.ico" },
  "protocol": "trayhost-jsonlines-v1",
  "copy": { "URL": "http://127.0.0.1:8001/" },
  "output": { "notify": true, "clipboard": false },
  "process": {
    "executable": "Build/win-x64/task-progress.exe",
    "arguments": ["worker"],
    "workingDirectory": "Build/win-x64"
  },
  "timeouts": {
    "startupSeconds": 60,
    "requestSeconds": 60,
    "shutdownSeconds": 15
  }
}
